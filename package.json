{
  "name": "ipatool-gui",
  "productName": "IPATool GUI",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19"
  },
  "description": "A fast cross-platform desktop GUI for ipatool - search the App Store, browse version history and download .ipa / .pkg packages.",
  "author": "ipatool-gui contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/a23bc/ipatool-gui.git"
  },
  "homepage": "https://github.com/a23bc/ipatool-gui",
  "keywords": [
    "ipatool",
    "app-store",
    "ipa",
    "electron",
    "desktop",
    "download",
    "apple",
    "macos",
    "windows",
    "linux"
  ],
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest --coverage.enabled=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux --x64 --arm64",
    "test:ci": "vitest run --reporter=dot"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.1.17",
    "@tanstack/react-virtual": "3.14.13",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "clsx": "2.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "zustand": "5.0.15"
  },
  "overrides": {
    "tar": "^7.4.3",
    "temp": {
      "rimraf": "^3.0.2"
    }
  }
}
